# ==============================================================================
# Herd Configuration Environment Variables Template
# Copy this file to '.env' in the root directory and modify values as needed.
# ==============================================================================

# Directory where models and logs are cached
# Default: ~/.herd
# HERD_HOME=/root/.herd

# Host IP address to bind the central Herd API gateway
# Default: 127.0.0.1 (Use 0.0.0.0 to expose to the local network)
HERD_HOST=127.0.0.1

# Port for the central Herd API gateway
# Default: 11434
HERD_PORT=11434

# Seconds of inactivity before stopping a model process (e.g. 5 minutes)
# Default: 300
HERD_IDLE_TIMEOUT=300

# Custom path to the llama-server binary
# Default: Automatically discovered in system PATH
# LLAMA_SERVER_BIN=/usr/local/bin/llama-server

# Custom path to the whisper-server binary
# Default: Automatically discovered in system PATH
# WHISPER_SERVER_BIN=/usr/local/bin/whisper-server
